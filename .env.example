# Anu Framework — example environment file.
#
# Copy to `.env` (git-ignored) or export these in your shell. The framework
# never ships keys and never reads a key from a tracked file.
#
# FRED / ALFRED — free key, no cost, instant:
#   https://fred.stlouisfed.org/docs/api/api_key.html
# Used by: skills/anu-variant/scripts/vintage_downloader.py
#   (also accepts --api-key; warns and continues if unset)
FRED_API_KEY=

# Optional: path to your PRIVATE scrub deny-list overlay for
# skills/anu-publish/audit.py. Organization-specific directory, tool, project
# and user names go in that file, which is never committed.
# See skills/anu-publish/scrub_patterns.json for the shape.
ANU_SCRUB_PATTERNS=

# Optional: data-repository integration for anu-doctor P37/P38/P39.
# ANU_DATA_REPOSITORY_DIR=data-repository
# ANU_DATA_REPOSITORY_LOADER=/path/to/loader.py
